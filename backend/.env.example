# ========================================================
# BHU-SYNC Environment Configuration Template (Sanitized)
# DO NOT COMMIT ACTUAL SECRETS OR PRIVATE KEYS TO REPOSITORY
# ========================================================

# Supabase Backend Connectivity
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key-here

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=your-secure-jwt-signing-secret-here

# SIH Demo Mode (Set to "true" to enable synthetic demo sandbox, "false" in production)
DEMO_MODE=true

# AI Copilot 2.0 (Optional Google Gemini API Key; uses deterministic grounded fallback if unset)
GEMINI_API_KEY=your-gemini-api-key-here

# Operational Environment
ENVIRONMENT=development
PORT=8000
